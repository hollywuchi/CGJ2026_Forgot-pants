      onLeft: 1
      dialogueText: "\u79BB\u5F00\u8FD9\u91CC\uFF0C\u6211\u4F1A\u4E0D\u4F1A\u518D\u4E5F\u89C1\u4E0D\u5230\u4F60\u4E86\u3002\r\n"
