      onLeft: 0
      dialogueText: "\u4F60\u60F3\uFF0C\u6211\u4E00\u76F4\u8DDF\u7740\u4F60\uFF0C\u4F60\u88AB\u5173\u5728\u8FF7\u5BAB\u91CC\uFF0C\u6211\u4E0D\u4E5F\u88AB\u5173\u8FDB\u53BB\u4E86\u5417\u3002\r\n"
