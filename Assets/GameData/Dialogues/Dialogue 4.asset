      onLeft: 0
      dialogueText: "\u54FC\u2026\u2026\u5C31\u7B97\u4F60\u6709\u624B\u4E0A\u90A3\u51E0\u9897\u951A\u70B9\uFF0C\u53C8\u600E\u4E48\u6837\u5462\uFF1F\r\n"
