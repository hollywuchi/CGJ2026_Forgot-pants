    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: -2065940341, guid: 21141dd32d32aec40b87c875d0397b5f, type: 3}
      onLeft: 0
      dialogueText: "\u4F60\u4EE5\u4E3A\u5C31\u51ED\u90A3\u4E2A\u53D1\u5149\u7684\u5C0F\u4E1C\u897F\uFF0C\u4F60\u5C31\u80FD\u627E\u5230\u51FA\u53BB\u7684\u8DEF\u5417\uFF1F\r\n"
