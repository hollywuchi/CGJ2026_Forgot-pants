      onLeft: 0
      dialogueText: "\u6211\u627E\u627E\u2026\u2026\u627E\u5230\u4E86\uFF01\u8FD9\u91CC\u6709\u81ED\u6C34\u6C9F\u91CC\u7684\u6C34\uFF0C\u8981\u4E0D\u8981\u5C1D\u5C1D\uFF1F\r\n"
