      isDown: 0
    - name: "\u4E01\u4E00 "
      faceImage: {fileID: 94668373, guid: 5f6b9687da3c80447ab08f1c0d46c171, type: 3}
      onLeft: 1
      dialogueText: "\u2026\u2026\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: -1857285780, guid: 21141dd32d32aec40b87c875d0397b5f, type: 3}
      onLeft: 0
      dialogueText: "\"\u4F60\u77E5\u9053\u5417\uFF0C\u4E0D\u559C\u6B22\u8BF4\u8BDD\u7684\u4EBA\uFF0C\u8BC1\u660E\u4ED6\u4EEC\u672C\u6765\u5C31\u4E0D\u8BA8\u4EBA\u559C\u6B22\u3002\u8D8A\u4E0D\u8BA8\u4EBA\u559C\u6B22\uFF0C\u8D8A\u662F\u8BB2\u66F4\n\u5C11\u7684\u8BDD\uFF0C\u7136\u540E\u4EBA\u4EEC\u538C\u6076\u4ED6\u7684\u7A0B\u5EA6\u66F4\u6DF1\u4E00\u5C42\u2026\u2026\"\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: -1857285780, guid: 21141dd32d32aec40b87c875d0397b5f, type: 3}
      onLeft: 0
      dialogueText: "\u4F60\u662F\u8FD9\u6837\u7684\u4EBA\u4E48\u2026\u2026\u6840\u6840\u6840\u2026\u2026\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
