      onLeft: 0
      dialogueText: "\u4F60\u8FD9\u4E2A\u5E74\u7EAA\u7684\u7537\u5B69\u5E94\u8BE5\u90FD\u559C\u6B22\u8FD9\u4E9B\u4E1C\u897F\u5662\u3002\r\n"
