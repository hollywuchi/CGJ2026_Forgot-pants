    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: 1102544808, guid: ac73621be7509f040bf2e81f0fa7dc26, type: 3}
      onLeft: 0
      dialogueText: "\u662F\u5440\uFF0C\u867D\u7136\u6211\u65E9\u5C31\u6B7B\u4E86\uFF0C\u4F46\u6211\u5176\u5B9E\u4E00\u76F4\u4E00\u76F4\u8DDF\u7740\u4F60\u5440\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: 1102544808, guid: ac73621be7509f040bf2e81f0fa7dc26, type: 3}
      onLeft: 0
      dialogueText: "\u6211\u90FD\u8BF4\u4E86\uFF0C\u6211\u662F\u5E7D\u7075\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\u4E01\u4E00 "
      faceImage: {fileID: 94668373, guid: 5f6b9687da3c80447ab08f1c0d46c171, type: 3}
