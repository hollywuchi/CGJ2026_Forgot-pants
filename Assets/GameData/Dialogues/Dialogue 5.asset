    - name: "\u4E01\u4E00 "
      faceImage: {fileID: -1622223984, guid: 5f6b9687da3c80447ab08f1c0d46c171, type: 3}
      onLeft: 1
      dialogueText: "\u8FD9\u662F\u4F60\u9020\u7684\u8FF7\u5BAB\u5417\uFF1F\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: 1102544808, guid: ac73621be7509f040bf2e81f0fa7dc26, type: 3}
      onLeft: 0
      dialogueText: "\u5F53\u7136\u4E0D\u662F\u5566\u3002\u4F60\u8BB0\u5FC6\u529B\u597D\u5DEE\u5440\uFF0C\u6211\u8BF4\u4E86\uFF0C\u8FD9\u662F\u4F60\u7684\u8FF7\u5BAB\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: 1102544808, guid: ac73621be7509f040bf2e81f0fa7dc26, type: 3}
      onLeft: 0
      dialogueText: "\u8FF7\u5BAB\u91CC\u90FD\u662F\u4F60\u7684\u8BB0\u5FC6\u5440\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\uFF1F\uFF1F "
