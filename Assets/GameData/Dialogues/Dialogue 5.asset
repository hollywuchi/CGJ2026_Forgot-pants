    - name: "\uFF1F\uFF1F "
      faceImage: {fileID: 1590829188, guid: ac73621be7509f040bf2e81f0fa7dc26, type: 3}
      onLeft: 0
      dialogueText: "\u505A\u54E5\u54E5\u7684\u81EA\u7136\u8981\u627F\u62C5\u7684\u591A\u4E00\u4E9B\uFF0C\u8FD9\u4E0D\u662F\u4F60\u8BF4\u7684\u5417\uFF1F\r\n"
