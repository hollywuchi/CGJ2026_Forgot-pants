    - name: "\u4E01\u4E00 "
      faceImage: {fileID: 94668373, guid: 5f6b9687da3c80447ab08f1c0d46c171, type: 3}
      onLeft: 1
      dialogueText: "\u2026\u2026\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\u4E01\u5FC6 "
      faceImage: {fileID: -464871121, guid: c34c2a83cc3ab934aafc55d373c8bbd0, type: 3}
      onLeft: 0
      dialogueText: "\u770B\u3002\u5E8A\u4E0A\u6CA1\u6709\u9C7C\u3002\u5BB6\u91CC\u6CA1\u6709\u9E1F\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\u4E01\u4E00 "
      faceImage: {fileID: 94668373, guid: 5f6b9687da3c80447ab08f1c0d46c171, type: 3}
      onLeft: 1
      dialogueText: "\u2026\u2026\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\u4E01\u5FC6 "
      faceImage: {fileID: 640668963, guid: c34c2a83cc3ab934aafc55d373c8bbd0, type: 3}
      onLeft: 0
      dialogueText: "\u6708\u4EAE\u662F\u660E\u4EAE\u7684\u9EC4\u8272\uFF0C\u661F\u661F\u662F\u6676\u83B9\u7684\u767D\u8272\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u2026\u2026\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u4E01\u5FC6\u644A\u5F00\u624B\u5FC3\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: "\u4E01\u5FC6 "
      faceImage: {fileID: 640668963, guid: c34c2a83cc3ab934aafc55d373c8bbd0, type: 3}
      onLeft: 0
      dialogueText: "\u8001\u54E5\uFF0C\u6709\u5B83\u5728\uFF0C\u6211\u5C31\u80FD\u590D\u6D3B\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u4E01\u5FC6\u7684\u624B\u5FC3\u4E2D\u51FA\u73B0\u4E00\u679A\u7ED3\u6676\uFF0C\u6A21\u6837\u6B63\u662F\u6211\u5728\u8FF7\u5BAB\u4E2D\u4E00\u76F4\u6293\u5728\u624B\u91CC\u7684\u4E1C\u897F\u3002\u90A3\u662F\u4E00\u9897\u951A\u70B9\uFF0C
        \u951A\u70B9\u7684\u900F\u660E\u5FC3\u810F\u91CC\u95EA\u56DE\u7740\u4EC0\u4E48\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u6211\u56DE\u5BB6\u4E86\uFF0C\u5750\u5728\u6C99\u53D1\u4E0A\uFF0C\u4E00\u5207\u90FD\u50CF\u4E00\u573A\u68A6\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u6211\u4ED9\u9E64\u4E00\u6837\u4F38\u957F\u8116\u5B50\uFF0C\u52AA\u529B\u60F3\u8981\u770B\u6E05\uFF0C\u4F46\u65E0\u8BBA\u6211\u600E\u6837\u52AA\u529B\uFF0C\u951A\u70B9\u4E2D\u5FC3\u90FD\u6709\u4E00\u5C42\u96FE\u6C14\uFF0C\u6726\u80E7
        \u5230\u8BA9\u4EBA\u770B\u4E0D\u89C1\u91CC\u9762\u7684\u56DE\u5FC6\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u4E01\u5FC6\u7684\u8BDD\u8BED\u968F\u7740\u65F6\u95F4\u4E00\u70B9\u70B9\u6DE1\u53BB\uFF0C\u6211\u62FF\u8D77\u7B14\u8BB0\u672C\u60F3\u8981\u8BB0\u5F55\u5173\u4E8E\u8FF7\u5BAB\u7684\u4E8B\uFF0C\u63D0\u8D77\u7B14\u5374\u53EA\u5199\u51FA
        \u51E0\u4E2A\u5B57\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u5FC3\u8FF7\u5BAB\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u2026\u2026\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u6211\u7ED9\u4E01\u5FC6\u70E7\u4E86\u5F88\u591A\u7EB8\uFF0C\u8DB3\u591F\u5730\u5E9C\u901A\u8D27\u81A8\u80C0\u4E86\u3002\r\n"
      hasToPause: 0
      isDown: 0
    - name: ' '
      faceImage: {fileID: 21300000, guid: f0c5a79c38f78924a9b99dd09059d65e, type: 3}
      onLeft: 0
      dialogueText: "\u6211\u7684\u8EAB\u540E\u518D\u4E5F\u6CA1\u6709\u5E7D\u7075\u3002\r\n"
      hasToPause: 0
      isDown: 0
