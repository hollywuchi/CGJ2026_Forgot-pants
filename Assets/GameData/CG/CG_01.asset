  - cgImage: {fileID: 0}
    dialogueText: "\u2026\u2026"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u6211\u7684\u4E16\u754C\u7ECF\u5E38\u51FA\u73B0\u5947\u602A\u7684\u4E1C\u897F\u3002"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u6709\u65F6\u5019\u662F\u98DE\u9E1F\u7A7F\u8FC7\u73BB\u7483\u8FDB\u5165\u6211\u7684\u623F\u95F4\uFF0C\u6709\u65F6\u662F\u6211\u5728\u88AB\u5B50\u4E0A\u53D1\u73B0\u51E0\u6761\u91D1\u9C7C\u3002"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u6709\u65F6\u5019\u6709\u4E00\u4E2A\u5973\u5B69\u7AD9\u5728\u6211\u7684\u8EAB\u8FB9\u3002"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u6211\u5BB3\u6015\u5979\u3002"
