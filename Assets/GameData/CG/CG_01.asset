    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u6211\u4ECE\u5E8A\u4E0A\u9192\u6765\uFF0C\u80CC\u4E0A\u51B7\u6C57\u50CF\u662F\u55B7\u8584\u800C\u51FA\u3002"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u591C\u8272\u7EDA\u70C2\uFF0C\u6708\u4EAE\u662F\u7EA2\u8272\u7684\u96E8\uFF0C\u9713\u8679\u95EA\u70C1\u84DD\u7684\u5149\u534E\u3002\u4ED6\u4EEC\u65CB\u8F6C\u7740\u7EA0\u7F20\u5728\u4E00\u8D77\uFF0C\u50CF\u68B5\u9AD8\u4E0E\u661F\u7A7A\u3002"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u6211\u77E5\u9053\u8FD9\u6837\u7684\u666F\u8272\u5728\u73B0\u5B9E\u4E2D\u5E76\u4E0D\u5B58\u5728\u3002"
    displayDuration: 1
    waitForInput: 1
    isDown: 0
  - cgImage: {fileID: 0}
    dialogueText: "\u81EA\u4ECE\u2026\u2026"
    displayDuration: 1
